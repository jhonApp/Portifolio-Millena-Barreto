# Copy this file to .env.local (git ignores it) and fill in the values.
# Never commit real keys. Local Supabase keys are printed by `npx supabase start`.

# --- Dev server ---
# Port used by `npm run dev` (pick the first free port above the default).
APP_PORT=3001

# --- Database group (Supabase) ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Payment group (AbacatePay, Pix only) ---
# RF-05 creates Pix charges with the API key alone; the webhook secret is used by RF-06.
# Use a development-mode key locally. Never commit a real key.
ABACATEPAY_API_KEY=
# RF-06 webhook: the secret chosen when registering the v2 webhook (32 characters or more) and the
# public key AbacatePay signs deliveries with (copy it from its webhook security page). Never commit real values.
ABACATEPAY_WEBHOOK_SECRET=
ABACATEPAY_WEBHOOK_PUBLIC_KEY=

# --- E-mail group (Resend; the sending domain must be verified in DNS) ---
RESEND_API_KEY=
EMAIL_FROM=

# --- Admin group ---
# The only e-mail allowed to enter the admin area.
ADMIN_EMAIL=

# --- Session group ---
# Secret (at least 32 random characters) that signs the attempt cookie and hashes IPs.
SESSION_SECRET=

# --- App group ---
# Public base URL of the site, used in e-mail links.
APP_URL=
# Contact e-mail shown in the privacy policy.
PRIVACY_CONTACT_EMAIL=

# --- Development only ---
# Allows a payment simulation outside production. Ignored when NODE_ENV=production.
ENABLE_PAYMENT_SIMULATION=false
# With the simulation on, the Pix gateway returns fake charges; set true to test the failure path.
PAYMENT_SIMULATION_FAIL=false
# A simulated charge reads as PAID this many seconds after creation (empty: never). Failure paths:
PAYMENT_SIMULATION_PAID_AFTER_SECONDS=
PAYMENT_SIMULATION_CHECK_FAIL=false
